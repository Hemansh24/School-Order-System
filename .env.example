DATABASE_URL="postgresql://postgres:postgres@localhost:5432/school_order_management"
FIREBASE_PROJECT_ID="system-order-34c0a"

# Optional: required only by npm run organisations:sync.
# GOOGLE_SHEETS_ID="your-spreadsheet-id"
# GOOGLE_SHEETS_RANGE="Sheet1!A1:T"
# Optional override for the grouped-schools master sheet. Defaults to the shared Group Sheet.
# GROUP_SHEETS_ID="1IVrJWu0wPmvTp-BjCGuWivnm8R3N2VRYEUzouTAgoGs"
# Required by npm run christian-groups:publish.
CHRISTIAN_GROUPS_SHEET_ID="1IVrJWu0wPmvTp-BjCGuWivnm8R3N2VRYEUzouTAgoGs"
CHRISTIAN_GROUPS_SHEET_RANGE="Christian-Group Sheet!A1:P"
# Publisher only: point this at a Google service-account JSON key. Share the
# source Sheet with that service-account email as Viewer. Dashboard users and
# normal master-data sync do not need Google credentials.
# GOOGLE_SHEETS_SERVICE_ACCOUNT_FILE="C:\\secure\\firebase-sheet-reader.json"
# Optional publisher-only Firebase Admin credential. It is not needed when
# Application Default Credentials for this Firebase project are already present.
# FIREBASE_ADMIN_SERVICE_ACCOUNT_FILE="C:\\secure\\firebase-admin.json"
