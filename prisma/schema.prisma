generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BillingToType {
  school
  vendor
}

enum OrderType {
  descriptive
  ambiguous
  combined
}

enum OrderClassification {
  normal
  direct_group
  group_parent
}

enum OrderStatus {
  draft
  pending_confirmation
  locked
  finalized
  cancelled
}

enum SourceType {
  TWO_A  @map("2A")
  TWO_B2 @map("2B2")
  TWO_C2 @map("2C2")
  GROUP
}

enum CancelOrOnHoldStatus {
  active
  cancelled
  on_hold
}

model School {
  schoolId      Int      @id @default(autoincrement()) @map("school_id")
  schoolCode    String   @unique @map("school_code")
  schoolName    String   @map("school_name")
  address       String?
  district      String?
  state         String?
  pincode       String?
  contactPerson String?  @map("contact_person")
  phone         String?
  email         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  vendorSchools VendorSchool[]

  @@index([district], map: "idx_schools_district")
  @@index([schoolName], map: "idx_schools_school_name")
  @@index([state], map: "idx_schools_state")
  @@map("schools")
}

model Organisation {
  id               BigInt   @id @default(autoincrement())
  groupCode        String?  @map("group_code")
  ptCode           String?  @map("pt_code")
  prCode           String   @unique @map("pr_code")
  organisationName String   @map("organisation_name")
  address          String?
  district         String?
  state            String?
  pinCode          String?  @map("pin_code")
  phone            String?
  email            String?
  website          String?
  actionStatus     String?  @map("action_status")
  remark           String?
  academicYear     String?  @map("academic_year")
  strength         Int?
  boardType        String?  @map("board_type")
  sessionStartFrom DateTime? @map("session_start_from") @db.Date
  minorityType     String?  @map("minority_type")
  saturdayStatus   String?  @map("saturday_status")
  workingStatus    Boolean? @map("working_status")
  sourceSheetRow   Int?     @map("source_sheet_row")
  sourceHash       String?  @map("source_hash")
  createdAt        DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  syncedAt         DateTime? @default(now()) @map("synced_at") @db.Timestamptz(6)

  @@index([district], map: "idx_organisations_district")
  @@index([organisationName], map: "idx_organisations_name")
  @@index([prCode], map: "idx_organisations_pr_code")
  @@index([state], map: "idx_organisations_state")
  @@map("organisations")
}

model SchoolGroup {
  schoolGroupId Int      @id @default(autoincrement()) @map("school_group_id")
  groupCode     String   @unique @map("group_code")
  groupName     String   @map("group_name")
  sourceHash    String?  @map("source_hash")
  syncedAt      DateTime? @map("synced_at") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  locations SchoolGroupLocation[]
  orders    OrderSheet1[]

  @@map("school_groups")
}

model SchoolGroupLocation {
  schoolGroupLocationId Int      @id @default(autoincrement()) @map("school_group_location_id")
  schoolGroupId         Int      @map("school_group_id")
  subCode               String   @map("sub_code")
  name                  String   @map("name")
  address               String?
  district              String?
  state                 String?
  pincode               String?
  centralizedDecision   String?  @map("centralized_decision")
  sourceHash            String?  @map("source_hash")
  syncedAt              DateTime? @map("synced_at") @db.Timestamptz(6)
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at")

  schoolGroup SchoolGroup @relation(fields: [schoolGroupId], references: [schoolGroupId], onDelete: Cascade)
  mappings    SchoolGroupSchool[] @relation("ConfirmedGroupLocation")
  suggestedMappings SchoolGroupSchool[] @relation("SuggestedGroupLocation")
  orders      OrderSheet1[]

  @@unique([schoolGroupId, subCode])
  @@map("school_group_locations")
}

model SchoolGroupSchool {
  schoolGroupSchoolId Int      @id @default(autoincrement()) @map("school_group_school_id")
  schoolGroupLocationId Int?   @map("school_group_location_id")
  ptCode               String   @unique @map("pt_code")
  suggestedLocationId  Int?     @map("suggested_location_id")
  reviewedAt           DateTime? @map("reviewed_at")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at")

  location SchoolGroupLocation? @relation("ConfirmedGroupLocation", fields: [schoolGroupLocationId], references: [schoolGroupLocationId], onDelete: SetNull)
  suggestedLocation SchoolGroupLocation? @relation("SuggestedGroupLocation", fields: [suggestedLocationId], references: [schoolGroupLocationId], onDelete: SetNull)

  @@map("school_group_schools")
}

model Vendor {
  vendorId      Int      @id @default(autoincrement()) @map("vendor_id")
  vendorCode    String   @unique @map("vendor_code")
  preVendorCode String?  @unique @map("pre_vendor_code")
  booksellerCode String? @map("bookseller_code")
  vendorName    String   @map("vendor_name")
  vendorType    String?  @map("vendor_type")
  vendorRating  String?  @map("vendor_rating")
  address       String?
  district      String?
  state         String?
  pinCode       String?  @map("pin_code")
  contactPerson String?  @map("contact_person")
  phone         String?
  email         String?
  taxId         String?  @map("tax_id")
  paymentStatus String?  @map("payment_status")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  vendorSchools VendorSchool[]

  @@map("vendors")
}

model VendorSchool {
  vendorSchoolId Int      @id @default(autoincrement()) @map("vendor_school_id")
  vendorId       Int      @map("vendor_id")
  schoolId       Int      @map("school_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  vendor Vendor @relation(fields: [vendorId], references: [vendorId], onDelete: Cascade, onUpdate: NoAction)
  school School @relation(fields: [schoolId], references: [schoolId], onDelete: Cascade, onUpdate: NoAction)

  @@unique([vendorId, schoolId])
  @@map("vendor_schools")
}

model Item {
  itemId            Int      @id @default(autoincrement()) @map("item_id")
  itemCode          String   @unique @map("item_code")
  itemName          String   @map("item_name")
  categoryCode      String   @default("LEGACY") @map("category_code")
  categoryType      String?  @map("category_type")
  subCategoryCode   String   @default("00") @map("sub_category_code")
  languageCode      String   @default("ENG") @map("language_code")
  customisationCode String   @default("00") @map("customisation_code")
  customisationName String?  @map("customisation_name")
  editionCode       String   @default("01") @map("edition_code")
  isbnNumber        String?  @map("isbn_number")
  mrp               Decimal? @db.Decimal(10, 2)
  obsolete          Boolean  @default(false)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([categoryCode])
  @@index([customisationCode])
  @@index([languageCode])
  @@index([editionCode])
  @@map("items")
}

model OrderSheet1 {
  orderSheet1Id        Int           @id @default(autoincrement()) @map("order_sheet_1_id")
  orderNo              Int           @map("order_no")
  sessionYear          String        @map("session_year")
  orderPlacedDate      DateTime      @map("order_placed_date") @db.Date
  orderReceivedDate    DateTime      @map("order_received_date") @db.Date
  expectedDeliveryDate DateTime      @map("expected_delivery_date") @db.Date
  billingToType        BillingToType @map("billing_to_type")
  billingToCode        String        @map("billing_to_code")
  billingToName        String        @map("billing_to_name")
  shippingToType       BillingToType @map("shipping_to_type")
  shippingToCode       String        @map("shipping_to_code")
  shippingToName       String        @map("shipping_to_name")
  shippingToSummary    String        @map("shipping_to_summary")
  orderType            OrderType     @map("order_type")
  classification        OrderClassification @default(normal) @map("classification")
  schoolGroupId         Int?         @map("school_group_id")
  schoolGroupLocationId Int?         @map("school_group_location_id")
  orderStatus          OrderStatus   @default(draft) @map("order_status")
  booksellerType       String?       @map("bookseller_type")
  booksellerRating     String?       @map("bookseller_rating")
  pendingPayment       Boolean       @default(false) @map("pending_payment")
  notes                String?
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @default(now()) @updatedAt @map("updated_at")

  descriptiveRows OrderSheet2A[]
  ambiguousSchools OrderSheet2B1[]
  ambiguousItems OrderSheet2B2[]
  combinedSchools  OrderSheet2C1[]
  combinedItems    OrderSheet2C2[]
  finalRows OrderSheet3[]
  schoolGroup SchoolGroup? @relation(fields: [schoolGroupId], references: [schoolGroupId])
  schoolGroupLocation SchoolGroupLocation? @relation(fields: [schoolGroupLocationId], references: [schoolGroupLocationId])
  groupParticipants OrderGroupParticipant[]
  groupItems OrderGroupItem[]
  groupChildLinks OrderGroupChildOrder[] @relation("GroupParent")
  groupParentLinks OrderGroupChildOrder[] @relation("GroupChild")

  @@index([orderType, orderStatus])
  @@map("order_sheet_1")
}

model OrderGroupParticipant {
  orderGroupParticipantId Int @id @default(autoincrement()) @map("order_group_participant_id")
  orderSheet1Id Int @map("order_sheet_1_id")
  ptCode String @map("pt_code")
  schoolName String @map("school_name")
  createdAt DateTime @default(now()) @map("created_at")
  order OrderSheet1 @relation(fields: [orderSheet1Id], references: [orderSheet1Id], onDelete: Cascade)
  @@unique([orderSheet1Id, ptCode])
  @@map("order_group_participants")
}

model OrderGroupItem {
  orderGroupItemId Int @id @default(autoincrement()) @map("order_group_item_id")
  orderSheet1Id Int @map("order_sheet_1_id")
  itemCode String @map("item_code")
  itemName String @map("item_name")
  quantity Int
  notes String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  order OrderSheet1 @relation(fields: [orderSheet1Id], references: [orderSheet1Id], onDelete: Cascade)
  @@unique([orderSheet1Id, itemCode])
  @@map("order_group_items")
}

model OrderGroupChildOrder {
  orderGroupChildOrderId Int @id @default(autoincrement()) @map("order_group_child_order_id")
  groupParentOrderId Int @map("group_parent_order_id")
  childOrderId Int @map("child_order_id")
  createdAt DateTime @default(now()) @map("created_at")
  groupParent OrderSheet1 @relation("GroupParent", fields: [groupParentOrderId], references: [orderSheet1Id], onDelete: Cascade)
  childOrder OrderSheet1 @relation("GroupChild", fields: [childOrderId], references: [orderSheet1Id], onDelete: Cascade)
  @@unique([groupParentOrderId, childOrderId])
  @@unique([childOrderId])
  @@map("order_group_child_orders")
}

model OrderSheet2A {
  orderSheet2AId      Int      @id @default(autoincrement()) @map("order_sheet_2a_id")
  orderSheet1Id       Int      @map("order_sheet_1_id")
  orderNo             Int      @map("order_no")
  orderModificationNo Int?     @map("order_modification_no")
  schoolCode          String   @map("school_code")
  schoolName          String   @map("school_name")
  itemCode            String   @map("item_code")
  itemName            String   @map("item_name")
  quantity            Int
  notes               String?
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")

  order OrderSheet1 @relation(fields: [orderSheet1Id], references: [orderSheet1Id], onDelete: Cascade, onUpdate: NoAction)

  @@index([orderNo])
  @@map("order_sheet_2a")
}

model OrderSheet2B1 {
  orderSheet2B1Id Int      @id @default(autoincrement()) @map("order_sheet_2b1_id")
  orderSheet1Id   Int      @map("order_sheet_1_id")
  orderNo         Int      @map("order_no")
  schoolCode      String   @map("school_code")
  schoolName      String   @map("school_name")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  order OrderSheet1 @relation(fields: [orderSheet1Id], references: [orderSheet1Id], onDelete: Cascade, onUpdate: NoAction)

  @@index([orderNo])
  @@map("order_sheet_2b1")
}

model OrderSheet2B2 {
  orderSheet2B2Id     Int      @id @default(autoincrement()) @map("order_sheet_2b2_id")
  orderSheet1Id       Int      @map("order_sheet_1_id")
  orderNo             Int      @map("order_no")
  orderModificationNo Int?     @map("order_modification_no")
  itemCode            String   @map("item_code")
  itemName            String   @map("item_name")
  groupedQuantity     Int      @map("grouped_quantity")
  notes               String?
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")

  order OrderSheet1 @relation(fields: [orderSheet1Id], references: [orderSheet1Id], onDelete: Cascade, onUpdate: NoAction)

  @@index([orderNo])
  @@map("order_sheet_2b2")
}

model OrderSheet2C1 {
  orderSheet2C1Id Int      @id @default(autoincrement()) @map("order_sheet_2c1_id")
  orderSheet1Id   Int      @map("order_sheet_1_id")
  orderNo         Int      @map("order_no")
  schoolCode      String   @map("school_code")
  schoolName      String   @map("school_name")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  order OrderSheet1 @relation(fields: [orderSheet1Id], references: [orderSheet1Id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([orderSheet1Id, schoolCode])
  @@index([orderNo])
  @@map("order_sheet_2c1")
}

model OrderSheet2C2 {
  orderSheet2C2Id Int      @id @default(autoincrement()) @map("order_sheet_2c2_id")
  orderSheet1Id   Int      @map("order_sheet_1_id")
  orderNo         Int      @map("order_no")
  itemCode        String   @map("item_code")
  itemName        String   @map("item_name")
  pooledQuantity  Int      @map("pooled_quantity")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  order OrderSheet1 @relation(fields: [orderSheet1Id], references: [orderSheet1Id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([orderSheet1Id, itemCode])
  @@index([orderNo])
  @@map("order_sheet_2c2")
}

model OrderSheet3 {
  orderSheet3Id          Int                  @id @default(autoincrement()) @map("order_sheet_3_id")
  orderSheet1Id          Int                  @map("order_sheet_1_id")
  orderNo                Int                  @map("order_no")
  sourceType             SourceType           @map("source_type")
  sourceId               Int                  @map("source_id")
  itemCode               String               @map("item_code")
  itemName               String               @map("item_name")
  quantity               Int
  parts                  String?
  transitId              String?              @map("transit_id")
  materialTransitTime    String?              @map("material_transit_time")
  dispatchDate           DateTime?            @map("dispatch_date") @db.Date
  feasibleDeliveryDate   DateTime?            @map("feasible_delivery_date") @db.Date
  possibleDeliveryDate   DateTime?            @map("possible_delivery_date") @db.Date
  acceptedByClient       Boolean              @default(false) @map("accepted_by_client")
  discountPercentage     Decimal?             @map("discount_percentage") @db.Decimal(5, 2)
  paymentReceived        Boolean              @default(false) @map("payment_received")
  cancelOrOnHoldStatus   CancelOrOnHoldStatus @default(active) @map("cancel_or_on_hold_status")
  plNumber               String?              @map("pl_number")
  plDate                 DateTime?            @map("pl_date") @db.Date
  bin                    String?
  notes                  String?
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @default(now()) @updatedAt @map("updated_at")

  order OrderSheet1 @relation(fields: [orderSheet1Id], references: [orderSheet1Id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([sourceType, sourceId])
  @@index([orderNo])
  @@map("order_sheet_3")
}
