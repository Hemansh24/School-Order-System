generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BillingToType {
  school
  vendor
}

enum OrderType {
  descriptive
  ambiguous
}

enum OrderStatus {
  draft
  revision_requested
  pending_confirmation
  locked
  finalized
  cancelled
}

enum SourceType {
  TWO_A  @map("2A")
  TWO_B2 @map("2B2")
}

enum CancelOrOnHoldStatus {
  active
  cancelled
  on_hold
}

model School {
  schoolId      Int      @id @default(autoincrement()) @map("school_id")
  schoolCode    String   @unique @map("school_code")
  schoolName    String   @map("school_name")
  address       String?
  district      String?
  state         String?
  pincode       String?
  contactPerson String?  @map("contact_person")
  phone         String?
  email         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  vendorSchools VendorSchool[]

  @@index([district], map: "idx_schools_district")
  @@index([schoolName], map: "idx_schools_school_name")
  @@index([state], map: "idx_schools_state")
  @@map("schools")
}

model Organisation {
  id               BigInt   @id @default(autoincrement())
  groupCode        String?  @map("group_code")
  ptCode           String?  @map("pt_code")
  prCode           String   @unique @map("pr_code")
  organisationName String   @map("organisation_name")
  address          String?
  district         String?
  state            String?
  pinCode          String?  @map("pin_code") @db.VarChar(10)
  phone            String?
  email            String?
  website          String?
  actionStatus     String?  @map("action_status")
  remark           String?
  academicYear     String?  @map("academic_year")
  strength         Int?
  boardType        String?  @map("board_type")
  sessionStartFrom DateTime? @map("session_start_from") @db.Date
  minorityType     String?  @map("minority_type")
  saturdayStatus   String?  @map("saturday_status")
  workingStatus    Boolean? @map("working_status")
  sourceSheetRow   Int?     @map("source_sheet_row")
  sourceHash       String?  @map("source_hash")
  createdAt        DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  syncedAt         DateTime? @default(now()) @map("synced_at") @db.Timestamptz(6)

  @@index([district], map: "idx_organisations_district")
  @@index([organisationName], map: "idx_organisations_name")
  @@index([prCode], map: "idx_organisations_pr_code")
  @@index([state], map: "idx_organisations_state")
  @@map("organisations")
}

model Vendor {
  vendorId      Int      @id @default(autoincrement()) @map("vendor_id")
  vendorCode    String   @unique @map("vendor_code")
  vendorName    String   @map("vendor_name")
  vendorType    String?  @map("vendor_type")
  vendorRating  String?  @map("vendor_rating")
  address       String?
  contactPerson String?  @map("contact_person")
  phone         String?
  email         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  vendorSchools VendorSchool[]

  @@map("vendors")
}

model VendorSchool {
  vendorSchoolId Int      @id @default(autoincrement()) @map("vendor_school_id")
  vendorId       Int      @map("vendor_id")
  schoolId       Int      @map("school_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  vendor Vendor @relation(fields: [vendorId], references: [vendorId], onDelete: Cascade, onUpdate: NoAction)
  school School @relation(fields: [schoolId], references: [schoolId], onDelete: Cascade, onUpdate: NoAction)

  @@unique([vendorId, schoolId])
  @@map("vendor_schools")
}

model Item {
  itemId            Int      @id @default(autoincrement()) @map("item_id")
  itemCode          String   @unique @map("item_code")
  itemName          String   @map("item_name")
  categoryCode      String   @default("LEGACY") @map("category_code")
  categoryType      String?  @map("category_type")
  subCategoryCode   String   @default("00") @map("sub_category_code")
  languageCode      String   @default("ENG") @map("language_code")
  customisationCode String   @default("00") @map("customisation_code")
  customisationName String?  @map("customisation_name")
  editionCode       String   @default("01") @map("edition_code")
  isbnNumber        String?  @map("isbn_number")
  mrp               Decimal? @db.Decimal(10, 2)
  obsolete          Boolean  @default(false)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([categoryCode])
  @@index([customisationCode])
  @@index([languageCode])
  @@index([editionCode])
  @@map("items")
}

model OrderSheet1 {
  orderSheet1Id        Int           @id @default(autoincrement()) @map("order_sheet_1_id")
  orderNo              Int           @map("order_no")
  subOrderNo           Int           @default(0) @map("sub_order_no")
  sessionYear          String        @map("session_year")
  orderReceivedDate    DateTime      @map("order_received_date") @db.Date
  expectedDeliveryDate DateTime      @map("expected_delivery_date") @db.Date
  billingToType        BillingToType @map("billing_to_type")
  billingToCode        String        @map("billing_to_code")
  billingToName        String        @map("billing_to_name")
  shippingToType       BillingToType @map("shipping_to_type")
  shippingToCode       String        @map("shipping_to_code")
  shippingToName       String        @map("shipping_to_name")
  shippingToSummary    String        @map("shipping_to_summary")
  orderType            OrderType     @map("order_type")
  orderStatus          OrderStatus   @default(draft) @map("order_status")
  booksellerType       String?       @map("bookseller_type")
  booksellerRating     String?       @map("bookseller_rating")
  pendingPayment       Boolean       @default(false) @map("pending_payment")
  notes                String?
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @default(now()) @updatedAt @map("updated_at")

  descriptiveRows OrderSheet2A[]
  ambiguousSchools OrderSheet2B1[]
  ambiguousItems OrderSheet2B2[]
  finalRows OrderSheet3[]

  @@unique([orderNo, subOrderNo])
  @@index([orderType, orderStatus])
  @@map("order_sheet_1")
}

model OrderSheet2A {
  orderSheet2AId      Int      @id @default(autoincrement()) @map("order_sheet_2a_id")
  orderSheet1Id       Int      @map("order_sheet_1_id")
  orderNo             Int      @map("order_no")
  subOrderNo          Int      @map("sub_order_no")
  orderModificationNo Int?     @map("order_modification_no")
  schoolCode          String   @map("school_code")
  schoolName          String   @map("school_name")
  itemCode            String   @map("item_code")
  itemName            String   @map("item_name")
  quantity            Int
  notes               String?
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")

  order OrderSheet1 @relation(fields: [orderSheet1Id], references: [orderSheet1Id], onDelete: Cascade, onUpdate: NoAction)

  @@index([orderNo, subOrderNo])
  @@map("order_sheet_2a")
}

model OrderSheet2B1 {
  orderSheet2B1Id Int      @id @default(autoincrement()) @map("order_sheet_2b1_id")
  orderSheet1Id   Int      @map("order_sheet_1_id")
  orderNo         Int      @map("order_no")
  subOrderNo      Int      @map("sub_order_no")
  schoolCode      String   @map("school_code")
  schoolName      String   @map("school_name")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  order OrderSheet1 @relation(fields: [orderSheet1Id], references: [orderSheet1Id], onDelete: Cascade, onUpdate: NoAction)

  @@index([orderNo, subOrderNo])
  @@map("order_sheet_2b1")
}

model OrderSheet2B2 {
  orderSheet2B2Id     Int      @id @default(autoincrement()) @map("order_sheet_2b2_id")
  orderSheet1Id       Int      @map("order_sheet_1_id")
  orderNo             Int      @map("order_no")
  subOrderNo          Int      @map("sub_order_no")
  orderModificationNo Int?     @map("order_modification_no")
  itemCode            String   @map("item_code")
  itemName            String   @map("item_name")
  groupedQuantity     Int      @map("grouped_quantity")
  notes               String?
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")

  order OrderSheet1 @relation(fields: [orderSheet1Id], references: [orderSheet1Id], onDelete: Cascade, onUpdate: NoAction)

  @@index([orderNo, subOrderNo])
  @@map("order_sheet_2b2")
}

model OrderSheet3 {
  orderSheet3Id          Int                  @id @default(autoincrement()) @map("order_sheet_3_id")
  orderSheet1Id          Int                  @map("order_sheet_1_id")
  orderNo                Int                  @map("order_no")
  subOrderNo             Int                  @map("sub_order_no")
  sourceType             SourceType           @map("source_type")
  sourceId               Int                  @map("source_id")
  itemCode               String               @map("item_code")
  itemName               String               @map("item_name")
  quantity               Int
  parts                  String?
  transitId              String?              @map("transit_id")
  materialTransitTime    String?              @map("material_transit_time")
  dispatchDate           DateTime?            @map("dispatch_date") @db.Date
  feasibleDeliveryDate   DateTime?            @map("feasible_delivery_date") @db.Date
  possibleDeliveryDate   DateTime?            @map("possible_delivery_date") @db.Date
  acceptedByClient       Boolean              @default(false) @map("accepted_by_client")
  discountPercentage     Decimal?             @map("discount_percentage") @db.Decimal(5, 2)
  paymentReceived        Boolean              @default(false) @map("payment_received")
  cancelOrOnHoldStatus   CancelOrOnHoldStatus @default(active) @map("cancel_or_on_hold_status")
  plNumber               String?              @map("pl_number")
  plDate                 DateTime?            @map("pl_date") @db.Date
  bin                    String?
  notes                  String?
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @default(now()) @updatedAt @map("updated_at")

  order OrderSheet1 @relation(fields: [orderSheet1Id], references: [orderSheet1Id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([sourceType, sourceId])
  @@index([orderNo, subOrderNo])
  @@map("order_sheet_3")
}
